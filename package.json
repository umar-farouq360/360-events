{
  "$schema": "./package.schema.json",
  "name": "360events-workspace",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.1",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "lint": "eslint . --cache --cache-strategy content",
    "typecheck": "pnpm -r run typecheck",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm --filter @360events/api run db:drift-check && pnpm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "globals": "^15.0.0",
    "supertest": "^7.3.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.0.5"
  }
}
